<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>LoadBoost</AssemblyName>
    <RootNamespace>LoadBoost</RootNamespace>
    <!-- KSP 安装根目录:可用环境变量 KSPDIR 覆盖(换机开发时无需改文件) -->
    <KspRoot Condition="'$(KSPDIR)'!=''">$(KSPDIR)</KspRoot>
    <KspRoot Condition="'$(KspRoot)'==''">E:\SteamLibrary\steamapps\common\Kerbal Space Program</KspRoot>
    <KspManaged>$(KspRoot)\KSP_x64_Data\Managed</KspManaged>
    <KspGameData>$(KspRoot)\GameData</KspGameData>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LoadBoost.Core\LoadBoost.Core.csproj" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KspManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(KspManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(KspManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(KspGameData)\000_Harmony\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
